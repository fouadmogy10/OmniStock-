# OmniStock MVP Environment Configuration Template
# All production values MUST be overridden with secure, random secrets.

# ==============================================================================
# 1. Runtime Application Server
# ==============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ==============================================================================
# 2. Runtime Database Connection (omnistock_app role only)
# STRICT ISOLATION: The runtime application MUST NEVER load or use migrator credentials!
# omnistock_app has NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS privileges.
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnistock
DB_APP_USER=omnistock_app
DB_APP_PASSWORD=AppSecurePass123!
DB_POOL_MAX=20

# ==============================================================================
# 3. Database Migration & Provisioning CLI Credentials (omnistock_migrator only)
# Used exclusively by TypeORM migration CLI and isolated test provisioning.
# NEVER imported or loaded into the NestJS runtime application process!
# ==============================================================================
DB_MIGRATOR_USER=omnistock_migrator
DB_MIGRATOR_PASSWORD=MigratorSecurePass123!

# ==============================================================================
# 4. Authentication & Security (JWT)
# Minimum 32 UTF-8 bytes (Buffer.byteLength(JWT_SECRET, 'utf8') >= 32).
# In production, must be generated using a CSPRNG (e.g. crypto.randomBytes(32).toString('hex')).
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_at_least_32_bytes_long_entropy_dev_only
JWT_EXPIRES_IN=1h

# ==============================================================================
# 5. External Webhook Secret Encryption Keyring (AES-256-GCM)
# Keys are supplied exclusively via environment/KMS (never stored in PostgreSQL).
# Format: <version>:<64-lowercase-hex-chars>,<version2>:<64-lowercase-hex-chars>
# Every key is strictly validated against /^[0-9a-f]{64}$/ before hex decoding into 32 bytes.
# ==============================================================================
WEBHOOK_SECRET_ENCRYPTION_CURRENT_KEY_VERSION=1
WEBHOOK_SECRET_ENCRYPTION_KEYS=1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# 6. Synchronization & Background Retry Worker Controls
# ==============================================================================
SYNC_WORKER_ENABLED=true
SYNC_WORKER_POLL_INTERVAL_MS=5000
SYNC_WORKER_BATCH_SIZE=10
SHUTDOWN_DRAIN_TIMEOUT_MS=15000

# ==============================================================================
# 7. Rate Limiting & Trusted Proxy Configuration
# TRUSTED_PROXY_IPS: optional comma-separated list of trusted proxy IPs/CIDRs (default empty).
# When empty, client-supplied X-Forwarded-For headers are completely ignored.
# ==============================================================================
TRUSTED_PROXY_IPS=
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_TENANT_ONBOARD_MAX=5
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_WEBHOOK_IP_MAX=60
RATE_LIMIT_WEBHOOK_SOURCE_IP_MAX=120
RATE_LIMIT_WEBHOOK_TENANT_MAX=120

