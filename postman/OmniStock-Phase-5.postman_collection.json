    {
      "name": "4. Split Allocation & All-Or-Nothing Rules",
      "item": [
        {
          "name": "01 - Create Order Requiring Split Allocation Across WH1 & WH2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Order is ALLOCATED with 2 warehouse splits', function () {",
                  "    pm.expect(jsonData.status).to.eql('ALLOCATED');",
                  "    pm.expect(jsonData.items).to.be.an('array');",
                  "    const allocations = jsonData.items[0].allocations;",
                  "    pm.expect(allocations).to.have.lengthOf(2);",
                  "    const wh1Alloc = allocations.find(a => a.warehouse_id === pm.environment.get('phase5Wh1Id'));",
                  "    const wh2Alloc = allocations.find(a => a.warehouse_id === pm.environment.get('phase5Wh2Id'));",
                  "    pm.expect(wh1Alloc.allocated_quantity).to.eql(5);",
                  "    pm.expect(wh2Alloc.allocated_quantity).to.eql(5);",
                  "});",
                  "pm.environment.set('phase5SplitOrderId', jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
