    {
      "name": "3. Audit Logs",
      "item": [
        {
          "name": "10 - List Tenant Audit Logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Returns tenant-scoped audit logs', function () {",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.total).to.be.at.least(1);",
                  "    jsonData.data.forEach(function (log) {",
                  "        pm.expect(log.tenant_id).to.eql(pm.environment.get('tenantId'));",
                  "        pm.expect(log.tenant_id).not.to.be.null;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/audit-logs?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["audit-logs"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
