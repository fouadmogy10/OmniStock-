  "item": [
    {
      "name": "1. Tenant Onboarding & Auth",
      "item": [
        {
          "name": "01 - Onboard Tenant 1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "pm.environment.set('tenantSlug', 'tenant-' + ts);",
                  "pm.environment.set('adminEmail', 'admin-' + ts + '@test.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response contains tenant and admin_user', function () {",
                  "    pm.expect(jsonData).to.have.property('tenant');",
                  "    pm.expect(jsonData).to.have.property('admin_user');",
                  "    pm.expect(jsonData.tenant.slug).to.eql(pm.environment.get('tenantSlug'));",
                  "    pm.expect(jsonData.admin_user.role).to.eql('ADMIN');",
                  "    pm.expect(jsonData.admin_user.password_hash).to.be.undefined;",
                  "});",
                  "pm.environment.set('tenantId', jsonData.tenant.id);",
                  "pm.environment.set('adminId', jsonData.admin_user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"OmniStock Primary Tenant\",\n  \"slug\": \"{{tenantSlug}}\",\n  \"admin_email\": \"{{adminEmail}}\",\n  \"admin_password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tenants",
              "host": ["{{baseUrl}}"],
              "path": ["tenants"]
            }
          }
        },
        {
          "name": "02 - Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response has access_token and user info', function () {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "    pm.expect(jsonData).to.have.property('user');",
                  "    pm.expect(jsonData.user.role).to.eql('ADMIN');",
                  "    pm.expect(jsonData.user.tenant_id).to.eql(pm.environment.get('tenantId'));",
                  "});",
                  "pm.environment.set('adminToken', jsonData.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_slug\": \"{{tenantSlug}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "03 - Get Tenant Profile (GET /tenants/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Profile matches active tenant', function () {",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get('tenantId'));",
                  "    pm.expect(jsonData.slug).to.eql(pm.environment.get('tenantSlug'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tenants/me",
              "host": ["{{baseUrl}}"],
              "path": ["tenants", "me"]
            }
          }
        }
      ]
    },
