    {
      "name": "4. Operational Dashboard Summary",
      "item": [
        {
          "name": "18 - Get Dashboard Summary - Valid ISO-8601 Parameters (T064, T065)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const from = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();",
                  "const to = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();",
                  "pm.environment.set('p6DashFrom', from);",
                  "pm.environment.set('p6DashTo', to);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Echoes UTC period correctly', function () {",
                  "    pm.expect(jsonData.period.from).to.eql(pm.environment.get('p6DashFrom'));",
                  "    pm.expect(jsonData.period.to).to.eql(pm.environment.get('p6DashTo'));",
                  "    pm.expect(jsonData.period.timezone).to.eql('UTC');",
                  "});",
                  "pm.test('Catalog and network metrics are accurate', function () {",
                  "    pm.expect(jsonData.catalog_and_network.total_products).to.be.at.least(1);",
                  "    pm.expect(jsonData.catalog_and_network.total_warehouses).to.be.at.least(1);",
                  "    pm.expect(jsonData.catalog_and_network.total_customers).to.be.at.least(1);",
                  "});",
                  "pm.test('Orders by status contains all 5 states', function () {",
                  "    pm.expect(jsonData.orders_by_status).to.have.property('DRAFT');",
                  "    pm.expect(jsonData.orders_by_status).to.have.property('PENDING');",
                  "    pm.expect(jsonData.orders_by_status).to.have.property('ALLOCATED');",
                  "    pm.expect(jsonData.orders_by_status).to.have.property('SHIPPED');",
                  "    pm.expect(jsonData.orders_by_status).to.have.property('CANCELLED');",
                  "    pm.expect(jsonData.orders_by_status.ALLOCATED).to.be.at.least(1);",
                  "});",
                  "pm.test('Period order value reflects committed amount', function () {",
                  "    pm.expect(jsonData.period_order_value.allocated_order_value).to.be.at.least(300.0);",
                  "    pm.expect(jsonData.period_order_value.combined_committed_order_value).to.be.at.least(300.0);",
                  "});",
                  "pm.test('Inventory summary reflects 50 on_hand - 2 reserved = 48 available', function () {",
                  "    pm.expect(jsonData.inventory_quantity_summary.total_on_hand).to.eql(50);",
                  "    pm.expect(jsonData.inventory_quantity_summary.total_reserved).to.eql(2);",
                  "    pm.expect(jsonData.inventory_quantity_summary.total_available).to.eql(48);",
                  "});",
                  "pm.test('Excludes cost/valuation fields from summary', function () {",
                  "    const rawText = pm.response.text();",
                  "    pm.expect(rawText).to.not.include('valuation');",
                  "    pm.expect(rawText).to.not.include('cost_price');",
                  "});",
                  "pm.test('Contains recent orders and stock movements arrays', function () {",
                  "    pm.expect(jsonData.recent_orders).to.be.an('array');",
                  "    pm.expect(jsonData.recent_orders.length).to.be.at.least(1);",
                  "    pm.expect(jsonData.recent_stock_movements).to.be.an('array');",
                  "    pm.expect(jsonData.recent_stock_movements.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{p6AdminTokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary?from={{p6DashFrom}}&to={{p6DashTo}}&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "summary"],
              "query": [
                {
                  "key": "from",
                  "value": "{{p6DashFrom}}"
                },
                {
                  "key": "to",
                  "value": "{{p6DashTo}}"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
