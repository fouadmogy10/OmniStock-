    {
      "name": "2. Inbound Webhooks & HMAC Verification",
      "item": [
        {
          "name": "11 - Process Valid Webhook with HMAC-SHA256 Signature (T031, T032, T068)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Math.floor(Date.now() / 1000);",
                  "const extId = 'ORD-EXT-' + Date.now();",
                  "pm.environment.set('p6ExternalId', extId);",
                  "pm.environment.set('p6Timestamp', ts.toString());",
                  "",
                  "const payload = JSON.stringify({",
                  "  customer_id: pm.environment.get('p6CustomerA1Id'),",
                  "  items: [",
                  "    { product_id: pm.environment.get('p6ProductA1Id'), quantity: 2 }",
                  "  ]",
                  "});",
                  "pm.environment.set('p6WebhookPayload', payload);",
                  "",
                  "const secret = pm.environment.get('p6WebhookSecret');",
                  "const message = ts.toString() + '.' + payload;",
                  "const sigHex = CryptoJS.HmacSHA256(message, secret).toString(CryptoJS.enc.Hex);",
                  "pm.environment.set('p6Signature', 'v1=' + sigHex);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Webhook processed and SUCCEEDED sync log returned', function () {",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "    pm.expect(jsonData.status).to.eql('SUCCEEDED');",
                  "    pm.expect(jsonData.order_id).to.be.a('string');",
                  "    pm.expect(jsonData.attempt_count).to.eql(1);",
                  "});",
                  "pm.environment.set('p6SyncLogId', jsonData.id);",
                  "pm.environment.set('p6CreatedOrderId', jsonData.order_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sync-Tenant-Slug",
                "value": "{{p6TenantSlugA}}"
              },
              {
                "key": "X-Sync-External-Id",
                "value": "{{p6ExternalId}}"
              },
              {
                "key": "X-Sync-Timestamp",
                "value": "{{p6Timestamp}}"
              },
              {
                "key": "X-Sync-Signature",
                "value": "{{p6Signature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{p6WebhookPayload}}"
            },
            "url": {
              "raw": "{{baseUrl}}/sync/webhook/salla",
              "host": ["{{baseUrl}}"],
              "path": ["sync", "webhook", "salla"]
            }
          }
        },
        {
          "name": "12 - Idempotent Duplicate Webhook Delivery -> 200 OK (T031)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK (Idempotent replay)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Returns existing SUCCEEDED sync log without creating new order', function () {",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get('p6SyncLogId'));",
                  "    pm.expect(jsonData.status).to.eql('SUCCEEDED');",
                  "    pm.expect(jsonData.order_id).to.eql(pm.environment.get('p6CreatedOrderId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sync-Tenant-Slug",
                "value": "{{p6TenantSlugA}}"
              },
              {
                "key": "X-Sync-External-Id",
                "value": "{{p6ExternalId}}"
              },
              {
                "key": "X-Sync-Timestamp",
                "value": "{{p6Timestamp}}"
              },
              {
                "key": "X-Sync-Signature",
                "value": "{{p6Signature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{p6WebhookPayload}}"
            },
            "url": {
              "raw": "{{baseUrl}}/sync/webhook/salla",
              "host": ["{{baseUrl}}"],
              "path": ["sync", "webhook", "salla"]
            }
          }
        },
        {
          "name": "13 - Reject Webhook with Malformed Signature -> 401 Unauthorized (T032)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Returns WEBHOOK_AUTH_UNAUTHORIZED', function () {",
                  "    pm.expect(jsonData.error_code).to.eql('WEBHOOK_AUTH_UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sync-Tenant-Slug",
                "value": "{{p6TenantSlugA}}"
              },
              {
                "key": "X-Sync-External-Id",
                "value": "MALFORMED-SIG-ID"
              },
              {
                "key": "X-Sync-Timestamp",
                "value": "{{p6Timestamp}}"
              },
              {
                "key": "X-Sync-Signature",
                "value": "invalid-sig-format"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/sync/webhook/salla",
              "host": ["{{baseUrl}}"],
              "path": ["sync", "webhook", "salla"]
            }
          }
        },
        {
          "name": "14 - Reject Webhook with Expired Timestamp Outside 300s Window -> 401 Unauthorized (T032)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const oldTs = Math.floor(Date.now() / 1000) - 301;",
                  "pm.environment.set('p6OldTimestamp', oldTs.toString());",
                  "const payload = '{}';",
                  "const secret = pm.environment.get('p6WebhookSecret');",
                  "const message = oldTs.toString() + '.' + payload;",
                  "const sigHex = CryptoJS.HmacSHA256(message, secret).toString(CryptoJS.enc.Hex);",
                  "pm.environment.set('p6OldSignature', 'v1=' + sigHex);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Returns WEBHOOK_AUTH_UNAUTHORIZED for expired timestamp', function () {",
                  "    pm.expect(jsonData.error_code).to.eql('WEBHOOK_AUTH_UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Sync-Tenant-Slug",
                "value": "{{p6TenantSlugA}}"
              },
              {
                "key": "X-Sync-External-Id",
                "value": "EXPIRED-TS-ID"
              },
              {
                "key": "X-Sync-Timestamp",
                "value": "{{p6OldTimestamp}}"
              },
              {
                "key": "X-Sync-Signature",
                "value": "{{p6OldSignature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/sync/webhook/salla",
              "host": ["{{baseUrl}}"],
              "path": ["sync", "webhook", "salla"]
            }
          }
        }
      ]
