    {
      "name": "3. Sync Logs, Attempts & Retries",
      "item": [
        {
          "name": "15 - List Sync Logs with Pagination (T063)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Returns sync logs data array', function () {",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.total).to.be.greaterThan(0);",
                  "    const log = jsonData.data.find(l => l.id === pm.environment.get('p6SyncLogId'));",
                  "    pm.expect(log).to.be.an('object');",
                  "    pm.expect(log.status).to.eql('SUCCEEDED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{p6AdminTokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sync/logs?limit=10&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["sync", "logs"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
