    {
      "name": "1. Sync Credentials Lifecycle",
      "item": [
        {
          "name": "09 - Provision Salla Webhook Credential (T068)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Returns one-time webhook secret', function () {",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "    pm.expect(jsonData.source).to.eql('salla');",
                  "    pm.expect(jsonData.webhook_secret).to.be.a('string');",
                  "    pm.expect(jsonData.webhook_secret.length).to.eql(64);",
                  "    pm.expect(jsonData.is_active).to.be.true;",
                  "});",
                  "pm.test('Does not expose ciphertexts or signing hashes', function () {",
                  "    pm.expect(jsonData.encrypted_secret).to.be.undefined;",
                  "    pm.expect(jsonData.encryption_iv).to.be.undefined;",
                  "    pm.expect(jsonData.secret_hash).to.be.undefined;",
                  "});",
                  "pm.environment.set('p6CredentialId', jsonData.id);",
                  "pm.environment.set('p6WebhookSecret', jsonData.webhook_secret);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{p6AdminTokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"salla\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sync/credentials",
              "host": ["{{baseUrl}}"],
              "path": ["sync", "credentials"]
            }
          }
        },
        {
          "name": "10 - List Webhook Credentials - Verify Safe Metadata (T068)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Returns credentials array with safe fields only', function () {",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.greaterThan(0);",
                  "    const cred = jsonData.find(c => c.id === pm.environment.get('p6CredentialId'));",
                  "    pm.expect(cred).to.be.an('object');",
                  "    pm.expect(cred.source).to.eql('salla');",
                  "    pm.expect(cred.is_active).to.be.true;",
                  "    pm.expect(cred.webhook_secret).to.be.undefined;",
                  "    pm.expect(cred.encrypted_secret).to.be.undefined;",
                  "    pm.expect(cred.secret_hash).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{p6AdminTokenA}}"
              }
